# Public Supabase values only. Never add a service-role key to a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only admin key (login works without it, but Platform Admin management
# and directories degrade to empty states). Supabase Dashboard -> API keys.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Optional exact public origin used for email-confirmation and Google OAuth callbacks.
# Vercel's deployment origin is also inferred from VERCEL_URL. Localhost:3000 is allowed in dev.
# NEXT_PUBLIC_SITE_URL=https://hard-health-records.vercel.app

# For plain-HTTP localhost only. Leave unset in Manus Preview and Vercel so auth cookies use SameSite=None; Secure.
AUTH_COOKIE_MODE=local-http

# ---------------------------------------------------------------------------
# Automatic database setup (WordPress-style)
# On every server start the app connects with DATABASE_URL and applies any
# pending supabase/migrations/*.sql file by itself (tracked in
# hard_setup.schema_migrations). A missing DATABASE_URL is NOT an error — the
# app runs and /setup tells you exactly what to add.
# Get the string from Supabase Dashboard -> Connect -> Connection string ->
# Session pooler (port 5432; the transaction pooler on 6543 cannot run migrations).
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Set to false to disable boot-time setup (the /setup page can still trigger it).
# AUTO_DB_SETUP=true

# Optional secret allowing /setup actions on an installed database without a
# platform-admin login (recommended when AUTO_DB_SETUP=false).
# SETUP_TOKEN=some-long-random-string
