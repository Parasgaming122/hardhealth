# Public Supabase values only. Never add a service-role key to a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional exact public origin used for email-confirmation and Google OAuth callbacks.
# Vercel's deployment origin is also inferred from VERCEL_URL. Localhost:3000 is allowed in dev.
# NEXT_PUBLIC_SITE_URL=https://hard-health-records.vercel.app

# For plain-HTTP localhost only. Leave unset in Manus Preview and Vercel so auth cookies use SameSite=None; Secure.
AUTH_COOKIE_MODE=local-http
